{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /api/v1/categories/ - Response Schema",
  "type": "object",
  "required": ["results", "paginationResult", "data"],
  "additionalProperties": false,
  "properties": {
    "results": {
      "type": "integer",
      "minimum": 0
    },
    "paginationResult": {
      "type": "object",
      "required": ["currntPage", "limit", "numberOfPages"],
      "additionalProperties": false,
      "properties": {
        "currntPage": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "numberOfPages": {
          "type": "integer",
          "minimum": 0
        },
        "next": {
          "type": "integer",
          "minimum": 1
        },
        "prev": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["_id", "name"],
        "additionalProperties": true,
        "properties": {
          "_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
